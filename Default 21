import uuid
import chromadb

from config import (
    VECTOR_STORE_PATH,
    COLLECTION_NAME
)


class VectorStore:

    def __init__(
        self,
        collection_name=COLLECTION_NAME,
        persist_directory=VECTOR_STORE_PATH
    ):

        self.client = chromadb.PersistentClient(
            path=persist_directory
        )

        self.collection = (
            self.client.get_or_create_collection(
                name=collection_name,
                metadata={
                    "description":
                    "PDF document embeddings"
                }
            )
        )

    # ==================================================
    # ADD DOCUMENTS
    # ==================================================

    def add_documents(
        self,
        documents,
        embeddings
    ):

        if not documents:
            return

        if len(documents) != len(embeddings):
            raise ValueError(
                "Number of documents and embeddings "
                "must be the same."
            )

        ids = []
        docs = []
        metas = []
        vectors = []

        for i, (doc, emb) in enumerate(
            zip(documents, embeddings)
        ):

            # --------------------------------------------------
            # Prefer deterministic chunk ID if available
            # --------------------------------------------------

            chunk_id = doc.metadata.get(
                "chunk_id"
            )

            if chunk_id:

                vector_id = chunk_id

            else:

                vector_id = (
                    f"doc_{uuid.uuid4().hex}"
                )

            ids.append(vector_id)

            docs.append(
                doc.page_content
            )

            metadata = dict(
                doc.metadata
            )

            metadata["doc_index"] = i

            metadata["content_length"] = (
                len(doc.page_content)
            )

            metas.append(metadata)

            # --------------------------------------------------
            # Convert embedding to list
            # --------------------------------------------------

            if hasattr(emb, "tolist"):
                vectors.append(
                    emb.tolist()
                )
            else:
                vectors.append(
                    list(emb)
                )

        # --------------------------------------------------
        # Add to Chroma
        # --------------------------------------------------

        self.collection.add(
            ids=ids,
            documents=docs,
            metadatas=metas,
            embeddings=vectors
        )

    # ==================================================
    # COUNT
    # ==================================================

    def count(self):

        return self.collection.count()

    # ==================================================
    # EXISTING HASH SUPPORT
    # ==================================================

    def get_existing_hashes(self):
        """
        Get all existing chunk hashes.
        """

        try:

            results = self.collection.get(
                include=["metadatas"]
            )

            if (
                not results
                or not results.get("metadatas")
            ):
                return set()

            return {
                meta.get("chunk_hash")
                for meta in results["metadatas"]
                if meta.get("chunk_hash")
            }

        except Exception:

            return set()

    # ==================================================
    # GET CHUNKS BELONGING TO DOCUMENT
    # ==================================================

    def get_document_chunks(
        self,
        document_id: str
    ):
        """
        Return all chunks belonging to a
        particular document.

        Returns:

            {
                chunk_hash: vector_id
            }

        Example:

            {
                "abc123...": "constitution_00001",
                "def456...": "constitution_00002"
            }
        """

        try:

            results = self.collection.get(
                where={
                    "document_id": document_id
                },
                include=["metadatas"]
            )

            if (
                not results
                or not results.get("metadatas")
            ):
                return {}

            ids = results.get(
                "ids",
                []
            )

            metadatas = results.get(
                "metadatas",
                []
            )

            chunk_map = {}

            for vector_id, metadata in zip(
                ids,
                metadatas
            ):

                chunk_hash = metadata.get(
                    "chunk_hash"
                )

                if chunk_hash:

                    chunk_map[
                        chunk_hash
                    ] = vector_id

            return chunk_map

        except Exception as exc:

            print(
                "Warning: Could not retrieve "
                f"document chunks: {exc}"
            )

            return {}

    # ==================================================
    # GET DOCUMENT HASH
    # ==================================================

    def get_document_hash(
        self,
        document_id: str
    ):
        """
        Get the document hash of the
        currently indexed document.
        """

        try:

            results = self.collection.get(
                where={
                    "document_id": document_id
                },
                include=["metadatas"],
                limit=1
            )

            if (
                not results
                or not results.get("metadatas")
            ):
                return None

            metadata = results[
                "metadatas"
            ][0]

            return metadata.get(
                "document_hash"
            )

        except Exception as exc:

            print(
                "Warning: Could not retrieve "
                f"document hash: {exc}"
            )

            return None

    # ==================================================
    # DELETE BY VECTOR IDS
    # ==================================================

    def delete_chunks(
        self,
        vector_ids
    ):
        """
        Delete specific vectors by their
        Chroma IDs.

        This is used when a chunk has been
        removed or replaced in a new document
        version.
        """

        if not vector_ids:
            return

        try:

            self.collection.delete(
                ids=vector_ids
            )

        except Exception as exc:

            raise RuntimeError(
                "Failed to delete chunks."
            ) from exc

    # ==================================================
    # DELETE BY HASH
    # ==================================================

    def delete_by_hash(
        self,
        chunk_hash: str
    ):
        """
        Delete all vectors having the
        specified chunk hash.
        """

        try:

            results = self.collection.get(
                where={
                    "chunk_hash": chunk_hash
                },
                include=["metadatas"]
            )

            if (
                results
                and results.get("ids")
            ):

                self.collection.delete(
                    ids=results["ids"]
                )

        except Exception as exc:

            print(
                "Warning: Could not delete "
                f"chunk {chunk_hash}: {exc}"
            )

    # ==================================================
    # GET DOCUMENT VECTOR IDS
    # ==================================================

    def get_document_vector_ids(
        self,
        document_id: str
    ):
        """
        Return all Chroma vector IDs belonging
        to a document.
        """

        try:

            results = self.collection.get(
                where={
                    "document_id": document_id
                },
                include=["metadatas"]
            )

            if not results:
                return []

            return results.get(
                "ids",
                []
            )

        except Exception as exc:

            print(
                "Warning: Could not retrieve "
                f"document vector IDs: {exc}"
            )

            return []

    # ==================================================
    # DELETE ENTIRE DOCUMENT
    # ==================================================

    def delete_document(
        self,
        document_id: str
    ):
        """
        Delete every vector belonging to
        a particular document.
        """

        vector_ids = (
            self.get_document_vector_ids(
                document_id
            )
        )

        if vector_ids:

            self.collection.delete(
                ids=vector_ids
            )
